<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only for production -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- Production domains -->
        <domain includeSubdomains="true">tsf-backend-production.up.railway.app</domain>
        <domain includeSubdomains="true">*.railway.app</domain>
        <domain includeSubdomains="true">*.herokuapp.com</domain>
    </domain-config>

    <!-- Allow HTTPS for development/ngrok during debugging -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">*.ngrok.io</domain>
        <domain includeSubdomains="true">*.ngrok-free.app</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Trust custom certificates for self-signed development servers -->
    <debug-overrides>
        <trust-anchors>
            <!-- System certs - always trusted -->
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- Default: strict security for all other domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">*</domain>
    </domain-config>
</network-security-config>