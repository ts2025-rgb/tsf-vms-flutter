<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 1. Default Policy: Enforce HTTPS and trust System Certificates -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 2. Local Development: Allow HTTP (Cleartext) for dev environments -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.1</domain>
        <domain includeSubdomains="true">ngrok-free.dev</domain>
        <domain includeSubdomains="true">loca.lt</domain>
    </domain-config>

    <!-- 3. Production: Explicitly trust base domains for Railway, Heroku, and Cloudflare -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">py4p.org</domain>
        <domain includeSubdomains="true">railway.app</domain>
        <domain includeSubdomains="true">pages.dev</domain>
        <domain includeSubdomains="true">herokuapp.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
