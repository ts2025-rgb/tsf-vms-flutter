<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only for production and tunnels -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- Production domains -->
        <domain includeSubdomains="true">tsf-backend-production.up.railway.app</domain>
        <domain includeSubdomains="true">railway.app</domain>
        <domain includeSubdomains="true">herokuapp.com</domain>
        <domain includeSubdomains="true">py4p.org</domain>
        <!-- Tunnels -->
        <domain includeSubdomains="true">ngrok-free.dev</domain>
        <domain includeSubdomains="true">loca.lt</domain>
        <domain includeSubdomains="true">trycloudflare.com</domain>
        <domain includeSubdomains="true">pages.dev</domain>
    </domain-config>

    <!-- Allow HTTP for local development and carrier-specific issues -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.*</domain>
        <!-- Temporary: Allow cleartext for Railway if the carrier proxy strips SSL -->
        <domain includeSubdomains="true">tsf-backend-production.up.railway.app</domain>
        <domain includeSubdomains="true">up.railway.app</domain>
    </domain-config>

    <!-- Trust custom certificates for self-signed development servers -->
    <debug-overrides>
        <trust-anchors>
            <!-- System certs - always trusted -->
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- Default: strict security for all other domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">*</domain>
    </domain-config>
</network-security-config>